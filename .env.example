# ── vLLM inference ────────────────────────────────────────────────────────────
HF_TOKEN="<YOUR_HUGGING_FACE_API_KEY>"

# ── LiteLLM AI Gateway ────────────────────────────────────────────────────────
LITELLM_MASTER_KEY="<YOUR_LITELLM_MASTER_KEY>"
POSTGRES_PASSWORD="<YOUR_POSTGRES_PASSWORD>"
REDIS_PASSWORD="<YOUR_REDIS_PASSWORD>"
OPENAI_API_KEY=""

# Number of LiteLLM gunicorn workers (default 2; increase for production).
LITELLM_WORKERS=2

# ── CLI → LiteLLM (OpenAI-compatible) ────────────────────────────────────────
# Traffic path: CLI → nginx :80 → LiteLLM :4000 → vLLM / Ollama / OpenAI
VLLM_API_BASE="http://localhost/v1"

# Use a virtual key created via `make key`, or LITELLM_MASTER_KEY for dev.
VLLM_API_KEY="<YOUR_LITELLM_VIRTUAL_OR_MASTER_KEY>"

# Must match a model_name defined in litellm/config.yaml.
VLLM_MODEL="qwen3-4b"

# ── Ollama (local fallback — LiteLLM routes to this when vLLM is down) ───────
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="tinyllama"

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD="<YOUR_GRAFANA_ADMIN_PASSWORD>"

# ── MLflow CLI tracking ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI="http://localhost:5000"

# ── Prompt (CLI) ──────────────────────────────────────────────────────────────
PROMPT="Explain LLMOps in one sentence."
