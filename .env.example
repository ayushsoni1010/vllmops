# ── vLLM inference ────────────────────────────────────────────────────────────
HF_TOKEN="<YOUR_HUGGING_FACE_API_KEY>"

# ── LiteLLM AI Gateway ────────────────────────────────────────────────────────
LITELLM_MASTER_KEY="<YOUR_LITELLM_MASTER_KEY>"
POSTGRES_PASSWORD="<YOUR_POSTGRES_PASSWORD>"
OPENAI_API_KEY=""

# ── CLI → LiteLLM (OpenAI-compatible) ────────────────────────────────────────
VLLM_API_BASE="http://localhost:4000/v1"
VLLM_API_KEY="<YOUR_LITELLM_VIRTUAL_OR_MASTER_KEY>"
VLLM_MODEL="qwen3-4b"

# ── Ollama (local fallback — also used by LiteLLM's fallback route) ──────────
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="tinyllama"

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD="<YOUR_GRAFANA_ADMIN_PASSWORD>"

# ── MLflow CLI tracking ───────────────────────────────────────────────────────
MLFLOW_TRACKING_URI="http://localhost:5000"

# ── Prompt (CLI) ──────────────────────────────────────────────────────────────
PROMPT="Explain LLMOps in one sentence."
