# ── vLLM inference ────────────────────────────────────────────────────────────
HF_TOKEN="<YOUR_HUGGING_FACE_API_KEY>"

# ── LiteLLM AI Gateway ────────────────────────────────────────────────────────
LITELLM_MASTER_KEY="<YOUR_LITELLM_MASTER_KEY>"
POSTGRES_PASSWORD="<YOUR_POSTGRES_PASSWORD>"
REDIS_PASSWORD="<YOUR_REDIS_PASSWORD>"
OPENAI_API_KEY=""

# Number of LiteLLM gunicorn workers (default 2; increase for production).
LITELLM_WORKERS=2

# ── CLI → LiteLLM (OpenAI-compatible) ────────────────────────────────────────
# Traffic path: CLI → nginx :80 → LiteLLM :4000 → vLLM / Ollama / OpenAI
VLLM_API_BASE="http://localhost/v1"

# Use a virtual key created via `make key`, or LITELLM_MASTER_KEY for dev.
VLLM_API_KEY="<YOUR_LITELLM_VIRTUAL_OR_MASTER_KEY>"

# Must match a model_name defined in litellm/config.yaml.
VLLM_MODEL="qwen3-4b"

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD="<YOUR_GRAFANA_ADMIN_PASSWORD>"

# ── MLflow CLI tracking ───────────────────────────────────────────────────────
# Points the llmops CLI at the containerized MLflow server.
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_DISABLE_AGENT_HINT=1
# Experiment name — all CLI runs are grouped here. Override per project/team.
MLFLOW_EXPERIMENT="vllmops"

# Run attribution — required; the CLI crashes loudly if these are unset.
RUN_USER="your-username"
RUN_EMAIL="your-email@example.com"

# Deployment environment used as a tag on every MLflow run. dev | staging | prod.
APP_ENV="dev"

# Git commit SHA — injected by CI/CD (e.g. GIT_COMMIT=$GITHUB_SHA).
# Leave unset for local dev; the tag is simply omitted when empty.
# GIT_COMMIT=""

# ── Prompt template (CLI) ─────────────────────────────────────────────────────
# Name of the template file in prompts/ (without .j2 extension).
PROMPT_TEMPLATE=default

# Template variables — injected into the template as {{ key }}.
# Add one PROMPT_VAR_<KEY>=<value> line per variable the template uses.
PROMPT_VAR_TOPIC=LLMOps

# Optional: override the directory where prompt templates are stored.
# Defaults to ./prompts relative to the working directory.
# PROMPTS_DIR="/absolute/path/to/prompts"

# ── Cost tracking (CLI) ───────────────────────────────────────────────────────
# Per-token USD rates used to compute cost_usd in MLflow. Default 0.0 for
# self-hosted inference. Set to equivalent cloud pricing for cost attribution.
PROMPT_TOKEN_COST=0.0
COMPLETION_TOKEN_COST=0.0
